{
  "schemaVersion": 1,
  "id": "ylctiertagger",
  "version": "${version}",
  "name": "YLC Tier Tagger",
  "description": "在玩家名字旁显示 YueLunarCourt PVP 榜单的段位。",
  "authors": ["天灵"],
  "license": "MIT",
  "icon": "assets/ylctiertagger/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ylcmc.tiertagger.client.YlcTierTaggerClient"
    ],
    "main": [
      "com.ylcmc.tiertagger.YlcTierTagger"
    ],
    "modmenu": [
      "com.ylcmc.tiertagger.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=1.20.5 <1.22",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  },
  "mixins": [
    "ylctiertagger.mixins.json"
  ]
}
