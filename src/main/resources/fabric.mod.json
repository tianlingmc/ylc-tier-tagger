{
  "schemaVersion": 1,
  "id": "ylctiertagger",
  "version": "${version}",
  "name": "YLCTierTagger",
  "description": "YueLunarCourt 服务器的专属 PVP 榜单 Tagger 模组，支持 Minecraft 1.20.1–1.21.11。The exclusive PVP leaderboard Tagger mod for the YueLunarCourt server, supporting Minecraft 1.20.1–1.21.11.",
  "authors": [
    "天灵"
  ],
  "license": "MIT",
  "icon": "assets/ylctiertagger/icon.png",
  "contact": {
    "homepage": "https://modrinth.com/mod/ylc-tier-tagger",
    "sources": "https://github.com/tianlingmc/ylc-tier-tagger",
    "issues": "https://github.com/tianlingmc/ylc-tier-tagger/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ylcmc.tiertagger.client.YlcTierTaggerClient"
    ],
    "main": [
      "com.ylcmc.tiertagger.YlcTierTagger"
    ],
    "modmenu": [
      "com.ylcmc.tiertagger.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_range}",
    "java": "${java_range}"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  },
  "mixins": [
    "ylctiertagger.mixins.json"
  ]
}
